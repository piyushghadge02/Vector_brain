# ── VectorBrain frontend (development) ─────────────────────────────
# Dependencies are baked in; source is mounted as a volume for hot reload.
FROM node:20-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
