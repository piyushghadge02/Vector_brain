# ── VectorBrain frontend configuration ──────────────────────────────
# Copy to `.env` for local development. Only VITE_* vars are embedded
# in the bundle — never put secrets here (the Groq key is server-side only).

# Where the browser reaches the FastAPI backend.
# Default is the same-origin `/api` path:
#   - `npm run dev` → the Vite dev server proxies /api to http://localhost:8000
#   - production    → nginx proxies /api/ to the backend container
# Set this ONLY if the API lives on a different origin than the served SPA,
# e.g. a separately hosted backend. (Requires the backend's CORS_ORIGINS to
# allow the frontend's origin.)
# VITE_API_BASE_URL=https://api.example.com/api
