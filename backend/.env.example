# ── VectorBrain backend configuration ─────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# dev | prod | test
ENV=dev
LOG_LEVEL=INFO
APP_NAME=VectorBrain

# PostgreSQL (asyncpg). Docker Compose default:
DATABASE_URL=postgresql+asyncpg://vectorbrain:vectorbrain@db:5432/vectorbrain

# CORS: comma-separated origins allowed to call the API (JSON list also works)
CORS_ORIGINS=["http://localhost:5173"]

# ── Document ingestion ───────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
UPLOAD_DIR=/data/uploads
MAX_FILE_MB=50
MAX_FILES_PER_REQUEST=10
CHUNK_MAX_TOKENS=512

# ── Phase 4 — RAG / Groq ─────────────────────────────────────────────
# Get a key at https://console.groq.com — keep it server-side ONLY.
# It is never sent to the frontend, never logged, never returned by the API.
GROQ_API_KEY=
# Model name is config (not code) because Groq retires models over time.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
RETRIEVAL_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=6000
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Abuse protection
RATE_LIMIT_QUERY_PER_MIN=20
